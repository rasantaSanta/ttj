# --- API-Keys (leer lassen = Mock-Daten fuer diese Quelle) ---

# TomTom: https://developer.tomtom.com/  -> My Dashboard -> Add new Key
TOMTOM_API_KEY=

# ASFINAG Open-Data-Feed (JSON). Leer lassen = Mock.
ASFINAG_FEED_URL=

# GTFS-Realtime VehiclePositions-Feed (protobuf) fuer echte OeV-Fahrzeuge.
# z.B. OeBB / Verkehrsverbund OOe. Leer lassen = Layer bleibt leer.
GTFS_RT_URL=
# Optionaler Header fuer den Feed, Format "Name: Wert" (z.B. "Authorization: Bearer xyz")
GTFS_RT_HEADER=

# --- Server ---
PORT=3001
# Cache-Dauer in Sekunden (schont die Rate-Limits der Anbieter)
CACHE_TTL_SECONDS=60
# Wie oft Fahrzeiten fuer die Historie gemessen werden (Minuten)
COLLECT_INTERVAL_MIN=10
